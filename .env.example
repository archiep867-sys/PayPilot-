# Backend secrets: keep in backend/.env only, never commit
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=none            # gemini | openai | none (rule-based parser fallback)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
CHANNEL3_API_KEY=
CURRENCY=USD
PAYPAL_WEBHOOK_ID=       # from PayPal app > Webhooks (needed for /api/webhooks/paypal)
DEMO_MODE=0            # 1 enables /api/demo/price so you can simulate a price drop on camera
